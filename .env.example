# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application URL
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# JWT Secret for OAuth2 Tokens
VNTEZ_JWT_SECRET=your-random-jwt-signing-secret-minimum-32-chars

# VNTEZ SDK Configuration
NEXT_PUBLIC_VNTEZ_CLIENT_ID=your_vntez_client_id
NEXT_PUBLIC_VNTEZ_REDIRECT_URI=http://localhost:3000/auth/callback
